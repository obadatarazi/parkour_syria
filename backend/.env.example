APP_NAME="Parkour Syria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost:8000

# Arabic is the live language. English content can be filled from the dashboard ahead of time.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# The website (SPA) and dashboard hosts, used for the sitemap and links.
WEBSITE_BASE_URL=https://parkoursyria.com
ADMIN_DASHBOARD_BASE_URL=https://admin.parkoursyria.com

# ---------------------------------------------------------------------------
# Feature flags (config/features.php). Both stay off for Phase 1.
# ---------------------------------------------------------------------------
# Off: every public request is answered in Arabic whatever X-Locale says.
FEATURE_PUBLIC_EN_LOCALE=false
# Off: shop routes (catalog, cart, orders, coupons) are not registered and shop permissions are
# not synced. Run `php artisan app:update-admin-roles` after turning it on.
FEATURE_ECOMMERCE=false

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# The load balancer / CDN in front of PHP, comma separated addresses or CIDRs, or "*" behind a proxy
# you control. Empty when PHP is reached directly. See config/trustedproxy.php.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL. Tests use their own database, see phpunit.xml (parkour_syria_testing).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkour_syria
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Prefer redis in production so the home payload and settings caches stay off the database.
CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@parkoursyria.com"
MAIL_FROM_NAME="${APP_NAME}"

# Seeded dashboard accounts (database/seeders/AdminUserSeeder.php). Change them before seeding
# anything that is not your own machine.
SEED_SUPER_ADMIN_EMAIL=admin@parkoursyria.com
SEED_SUPER_ADMIN_PASSWORD=password
SEED_SUPERVISOR_EMAIL=supervisor@parkoursyria.com
SEED_SUPERVISOR_PASSWORD=password

# Host injected into OpenAPI servers[]. Production: https://api.parkoursyria.com
L5_SWAGGER_CONST_HOST=http://localhost:8000
# Never enable generate_always on production.
L5_SWAGGER_GENERATE_ALWAYS=false
