# Parkour Syria backend (parkour_syria/backend).
# Local dev: Vite proxies /api → http://localhost:8000 (php artisan serve).
VITE_API_URL=/api
# Production:
# VITE_API_URL=https://api.parkoursyria.com/api

# Optional override for files under /storage/... when the API is on another host.
# VITE_MEDIA_BASE_URL=https://api.parkoursyria.com

# The public site, for "view on website" links.
VITE_STOREFRONT_URL=https://parkoursyria.com

# Set to "true" only for mock data instead of the Laravel backend.
VITE_USE_MOCKS=false

# The dormant shop. Keep in step with the backend FEATURE_ECOMMERCE: while "false", products,
# brands, orders and the rest are neither routed nor shown in the nav.
VITE_FEATURE_ECOMMERCE=false

# The public site's English locale. The dashboard UI keeps both languages either way (Arabic default).
VITE_FEATURE_PUBLIC_EN_LOCALE=false
